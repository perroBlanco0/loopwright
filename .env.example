# Nebius Token Factory API key — https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Orchestrator port
PORT=3000

# Docker image tag the orchestrator launches per mission
LOOPWRIGHT_AGENT_IMAGE=loopwright-agent:latest

# Optional: override model IDs per tier
# NEBIUS_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
